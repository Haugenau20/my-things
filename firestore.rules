rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(inventoryId) {
      let policy = get(/databases/$(database)/documents/inventories/$(inventoryId)).data;
      return request.auth != null
        && inventoryId.matches('[A-Za-z0-9_-]{1,128}')
        && policy.keys().hasAll(['schemaVersion', 'ownerUid'])
        && policy.schemaVersion == 2
        && policy.ownerUid is string
        && policy.ownerUid == request.auth.uid;
    }

    function validSettings() {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'ownerUid', 'displayName', 'defaultCurrency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'ownerUid', 'displayName', 'defaultCurrency', 'createdAt', 'updatedAt'])
        && data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'defaultCurrency', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.displayName.matches('.*[^\\s].*')
        && (data.defaultCurrency == null || currency(data.defaultCurrency))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    function id(value) { return value is string && value.matches('[A-Za-z0-9_-]{1,128}'); }
    function file(data, path, edge, bytes) {
      return data is map && data.keys().hasOnly(['storagePath','contentType','byteSize','width','height','sha256'])
        && data.storagePath == path && data.contentType == 'image/jpeg'
        && data.byteSize is int && data.byteSize > 0 && data.byteSize <= bytes
        && data.width is int && data.width > 0 && data.width <= edge
        && data.height is int && data.height > 0 && data.height <= edge
        && data.sha256 is string && data.sha256.matches('[a-f0-9]{64}');
    }
    function photo(data, inventoryId, itemId, state) {
      let prefix = 'inventories/' + inventoryId + '/items/' + itemId + '/photos/' + data.id + '/';
      return data is map && data.keys().hasOnly(['id','state','detail','thumbnail']) && id(data.id)
        && data.state == state && file(data.detail, prefix + 'detail.jpg', 2000, 8388608)
        && file(data.thumbnail, prefix + 'thumb.jpg', 400, 524288);
    }
    function slot(photos, index, inventoryId, itemId, state) {
      return photos.size() <= index || photo(photos[index], inventoryId, itemId, state);
    }
    function photoId(photos, index, missing) { return photos.size() > index ? photos[index].id : missing; }
    function photos(data, inventoryId, itemId, state) {
      return data is list && data.size() > 0 && data.size() <= 2
        && [photoId(data,0,'!0'),photoId(data,1,'!1')].toSet().size() == 2
        && slot(data,0,inventoryId,itemId,state) && slot(data,1,inventoryId,itemId,state);
    }
    function location(data, inventoryId) {
      return data.boxId == null && (data.roomId == null ||
        (id(data.roomId) && assignment(inventoryId,'rooms',data.roomId)));
    }
    function assignment(inventoryId, collection, locationId) {
      let before = get(/databases/$(database)/documents/inventories/$(inventoryId)/$(collection)/$(locationId)).data;
      let after = getAfter(/databases/$(database)/documents/inventories/$(inventoryId)/$(collection)/$(locationId)).data;
      return before.schemaVersion == 2 && after.schemaVersion == 2
        && before.archivedAt == null && after.archivedAt == null && after.revision == before.revision + 1;
    }
    function newCapture(data, inventoryId, itemId) {
      return id(itemId) && data.keys().hasOnly(['schemaVersion','revision','name','quantity','estimatedValue','serialNumber','notes','category',
        'roomId','boxId','reviewStatus','decision','progress','completedAt','recordState','coverPhotoId','photos','createdAt','updatedAt','deletedAt'])
        && data.schemaVersion == 2 && data.revision == 1 && data.name is string
        && data.name.size() > 0 && data.name.size() <= 200 && data.name.matches('.*[^\\s].*')
        && data.quantity == 1 && data.estimatedValue == null && data.serialNumber == null && data.notes == '' && data.category == null
        && data.reviewStatus in ['needs_review','reviewed'] && data.decision == 'undecided' && data.progress == 'not_started'
        && data.completedAt == null && data.deletedAt == null && data.coverPhotoId == null
        && data.createdAt == request.time && data.updatedAt == request.time
        && location(data,inventoryId)
        && ((data.recordState == 'draft' && photos(data.photos,inventoryId,itemId,'pending'))
          || (data.recordState == 'ready' && data.photos == []));
    }
    function unchangedPhoto(before, after) {
      return before.id == after.id && before.detail == after.detail && before.thumbnail == after.thumbnail;
    }
    function sameSlot(before, after, index) { return before.size() <= index || unchangedPhoto(before[index],after[index]); }
    function completion(data, inventoryId, itemId) {
      let before = resource.data;
      return before.recordState == 'draft' && data.recordState == 'ready' && data.coverPhotoId == before.photos[0].id
        && data.diff(before).affectedKeys().hasOnly(['revision','updatedAt','recordState','coverPhotoId','photos'])
        && data.photos.size() == before.photos.size() && photos(data.photos,inventoryId,itemId,'ready')
        && sameSlot(before.photos,data.photos,0) && sameSlot(before.photos,data.photos,1);
    }
    function discard(data) {
      return resource.data.recordState == 'draft' && data.recordState == 'deleting'
        && data.diff(resource.data).affectedKeys().hasOnly(['revision','updatedAt','recordState']);
    }
    function firstPhotos(data, inventoryId, itemId) {
      let before = resource.data;
      return before.recordState == 'ready' && before.deletedAt == null && before.coverPhotoId == null
        && data.diff(before).affectedKeys().hasOnly(['revision','updatedAt','photos','coverPhotoId'])
        && ((before.photos == [] && data.coverPhotoId == null && photos(data.photos,inventoryId,itemId,'pending'))
          || (before.photos.size() > 0 && data.photos.size() == before.photos.size()
            && before.photos[0].state == 'pending'
            && (before.photos.size() == 1 || before.photos[1].state == 'pending')
            && sameSlot(before.photos,data.photos,0) && sameSlot(before.photos,data.photos,1)
            && ((data.coverPhotoId == before.photos[0].id && photos(data.photos,inventoryId,itemId,'ready'))
              || (data.coverPhotoId == null && photos(data.photos,inventoryId,itemId,'deleting'))))
          || (before.photos.size() > 0 && before.photos[0].state == 'deleting'
            && (before.photos.size() == 1 || before.photos[1].state == 'deleting')
            && data.photos == [] && data.coverPhotoId == null));
    }
    function newRoom(data, roomId) {
      return id(roomId) && data.keys().hasOnly(['schemaVersion','name','sortOrder','revision','createdAt','updatedAt','archivedAt'])
        && data.schemaVersion == 2 && data.name is string && data.name.size() > 0 && data.name.size() <= 100 && data.name.matches('.*[^\\s].*')
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100000 && data.revision == 1
        && data.createdAt == request.time && data.updatedAt == request.time && data.archivedAt == null;
    }
    function currency(value) {
      return value is string && value.matches('AED|AFN|ALL|AMD|ANG|AOA|ARS|AUD|AWG|AZN|BAM|BBD|BDT|BGN|BHD|BIF|BMD|BND|BOB|BRL|BSD|BTN|BWP|BYN|BZD|CAD|CDF|CHF|CLP|CNY|COP|CRC|CUC|CUP|CVE|CZK|DJF|DKK|DOP|DZD|EGP|ERN|ETB|EUR|FJD|FKP|GBP|GEL|GHS|GIP|GMD|GNF|GTQ|GYD|HKD|HNL|HRK|HTG|HUF|IDR|ILS|INR|IQD|IRR|ISK|JMD|JOD|JPY|KES|KGS|KHR|KMF|KPW|KRW|KWD|KYD|KZT|LAK|LBP|LKR|LRD|LSL|LYD|MAD|MDL|MGA|MKD|MMK|MNT|MOP|MRU|MUR|MVR|MWK|MXN|MYR|MZN|NAD|NGN|NIO|NOK|NPR|NZD|OMR|PAB|PEN|PGK|PHP|PKR|PLN|PYG|QAR|RON|RSD|RUB|RWF|SAR|SBD|SCR|SDG|SEK|SGD|SHP|SLE|SLL|SOS|SRD|SSP|STN|SVC|SYP|SZL|THB|TJS|TMT|TND|TOP|TRY|TTD|TWD|TZS|UAH|UGX|USD|UYU|UZS|VES|VND|VUV|WST|XAF|XCD|XCG|XDR|XOF|XPF|XSU|YER|ZAR|ZMW|ZWG|ZWL');
    }
    function money(data) {
      return data == null || (data is map && data.keys().hasOnly(['amountMinor','currency'])
        && data.amountMinor is int && data.amountMinor >= 0 && data.amountMinor <= 9007199254740991 && currency(data.currency));
    }
    function readyPhotos(data) {
      return data.photos.size() == 0 || (data.photos[0].state == 'ready' && (data.photos.size() == 1 || data.photos[1].state == 'ready'));
    }
    function permanentMarker(data) {
      return resource.data.recordState == 'ready' && resource.data.deletedAt is timestamp && readyPhotos(resource.data)
        && data.recordState == 'deleting' && data.diff(resource.data).affectedKeys().hasOnly(['recordState','revision','updatedAt']);
    }
    function editedLocation(data, inventoryId) {
      return (data.roomId == null || (id(data.roomId) &&
          (data.roomId == resource.data.roomId || assignment(inventoryId,'rooms',data.roomId))))
        && (data.boxId == null || (id(data.boxId) &&
          ((data.boxId == resource.data.boxId && !(resource.data.deletedAt != null && data.deletedAt == null))
            || assignment(inventoryId,'boxes',data.boxId))));
    }
    function workflow(data) {
      let before = resource.data;
      return data.decision in ['undecided','store','take','sell','give_away'] && data.progress in ['not_started','in_progress','completed']
        && (data.decision != 'undecided' || data.progress == 'not_started')
        && (data.progress == 'completed' ? (data.completedAt is timestamp &&
          (before.progress == 'completed' && before.decision == data.decision ? data.completedAt == before.completedAt : data.completedAt == request.time)) : data.completedAt == null)
        && (data.decision == before.decision || data.progress == 'not_started')
        && (!(data.decision in ['sell','give_away']) || data.progress != 'completed' || data.boxId == null);
    }
    function metadataEdit(data, inventoryId) {
      let before = resource.data;
      let changed = data.diff(before).affectedKeys();
      return before.recordState == 'ready' && readyPhotos(before) && data.schemaVersion == 2
        && changed.hasOnly(['revision','updatedAt','name','quantity','estimatedValue','serialNumber','notes','category','roomId','boxId','reviewStatus','decision','progress','completedAt','deletedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200 && data.name.matches('.*[^\\s].*')
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 100000 && money(data.estimatedValue)
        && (data.serialNumber == null || (data.serialNumber is string && data.serialNumber.size() <= 200))
        && data.notes is string && data.notes.size() <= 10000 && (data.category == null || (data.category is string && data.category.size() <= 100))
        && data.reviewStatus in ['needs_review','reviewed'] && editedLocation(data,inventoryId) && workflow(data)
        && (changed.hasAny(['deletedAt']) ? (changed.hasOnly(['revision','updatedAt','deletedAt'])
          && (before.deletedAt == null ? data.deletedAt == request.time : data.deletedAt == null)) : before.deletedAt == null);
    }
    function validLocationRecord(data, box) {
      return data.schemaVersion == 2 && (box ? data.keys().hasOnly(['schemaVersion','label','sortOrder','revision','notes','createdAt','updatedAt','archivedAt'])
          && data.label is string && data.label.size() > 0 && data.label.size() <= 100 && data.label.matches('.*[^\\s].*')
          && data.notes is string && data.notes.size() <= 10000
        : data.keys().hasOnly(['schemaVersion','name','sortOrder','revision','createdAt','updatedAt','archivedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100 && data.name.matches('.*[^\\s].*'))
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100000;
    }
    function editLocation(data, box) {
      return validLocationRecord(data,box) && data.revision == resource.data.revision + 1 && data.revision <= 9007199254740991
        && data.updatedAt == request.time && data.diff(resource.data).affectedKeys().hasOnly(box ? ['label','notes','sortOrder','archivedAt','revision','updatedAt'] : ['name','sortOrder','archivedAt','revision','updatedAt'])
        && (data.archivedAt == resource.data.archivedAt || data.archivedAt == null || (resource.data.archivedAt == null && data.archivedAt == request.time));
    }
    function restorePath(inventoryId) { return /databases/$(database)/documents/inventories/$(inventoryId)/restores/active; }
    function unlocked(inventoryId) {
      return !existsAfter(restorePath(inventoryId)) || getAfter(restorePath(inventoryId)).data.state == 'completed';
    }
    function restoring(inventoryId) { return get(restorePath(inventoryId)).data.state == 'restoring'; }
    function claimPath(inventoryId, kind, recordId) {
      return /databases/$(database)/documents/inventories/$(inventoryId)/restores/active/records/$(kind + '_' + recordId);
    }
    function restoreClaim(inventoryId, kind, recordId) {
      let claim = getAfter(claimPath(inventoryId,kind,recordId)).data;
      let operation = get(restorePath(inventoryId)).data;
      return operation.state == 'restoring' && claim.operationId == operation.operationId
        && claim.kind == kind && claim.recordId == recordId;
    }
    function pendingRestoreItem(inventoryId, itemId) {
      return restoring(inventoryId) && get(claimPath(inventoryId,'item',itemId)).data.state == 'pending'
        && get(claimPath(inventoryId,'item',itemId)).data.operationId == get(restorePath(inventoryId)).data.operationId;
    }
    function restoredLocation(data, inventoryId, kind, recordId) {
      return restoreClaim(inventoryId,kind,recordId) && id(recordId) && validLocationRecord(data,kind == 'box')
        && data.revision == 1 && data.createdAt is timestamp && data.updatedAt == request.time
        && (data.archivedAt == null || data.archivedAt is timestamp);
    }
    function historicalLocation(data, inventoryId) {
      return (data.roomId == null || (id(data.roomId)
          && exists(/databases/$(database)/documents/inventories/$(inventoryId)/rooms/$(data.roomId))))
        && (data.boxId == null || (id(data.boxId)
          && exists(/databases/$(database)/documents/inventories/$(inventoryId)/boxes/$(data.boxId))));
    }
    function restoredItem(data, inventoryId, itemId) {
      return restoreClaim(inventoryId,'item',itemId) && id(itemId)
        && getAfter(claimPath(inventoryId,'item',itemId)).data.state == 'pending'
        && data.keys().hasOnly(['schemaVersion','revision','name','quantity','estimatedValue','serialNumber','notes','category',
          'roomId','boxId','reviewStatus','decision','progress','completedAt','recordState','coverPhotoId','photos','createdAt','updatedAt','deletedAt'])
        && data.schemaVersion == 2 && data.revision == 1 && data.createdAt is timestamp && data.updatedAt == request.time
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200 && data.name.matches('.*[^\\s].*')
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 100000 && money(data.estimatedValue)
        && (data.serialNumber == null || (data.serialNumber is string && data.serialNumber.size() <= 200))
        && data.notes is string && data.notes.size() <= 10000 && (data.category == null || (data.category is string && data.category.size() <= 100))
        && data.reviewStatus in ['needs_review','reviewed'] && historicalLocation(data,inventoryId)
        && data.decision in ['undecided','store','take','sell','give_away'] && data.progress in ['not_started','in_progress','completed']
        && (data.decision != 'undecided' || data.progress == 'not_started')
        && (data.progress == 'completed' ? data.completedAt is timestamp : data.completedAt == null)
        && (!(data.decision in ['sell','give_away']) || data.progress != 'completed' || data.boxId == null)
        && data.recordState == 'ready' && data.photos == [] && data.coverPhotoId == null && data.deletedAt == null;
    }
    function restoredItemFinal(data, inventoryId, itemId) {
      let before = get(claimPath(inventoryId,'item',itemId)).data;
      let after = getAfter(claimPath(inventoryId,'item',itemId)).data;
      return pendingRestoreItem(inventoryId,itemId) && before.state == 'pending' && after.state == 'verified'
        && resource.data.recordState == 'ready' && readyPhotos(resource.data)
        && data.diff(resource.data).affectedKeys().hasOnly(['deletedAt','coverPhotoId','revision','updatedAt'])
        && data.deletedAt == after.deletedAt && data.coverPhotoId == after.coverPhotoId
        && (data.photos.size() == 0 ? data.coverPhotoId == null : (data.coverPhotoId == data.photos[0].id || (data.photos.size() == 2 && data.coverPhotoId == data.photos[1].id)));
    }
    function restoreTotal(data) { return data.counts.items + data.counts.rooms + data.counts.boxes; }
    function validRestore(data) {
      return data.keys().hasOnly(['schemaVersion','revision','operationId','exportId','manifestSha256','state','counts','claimedRecords','completedRecords','createdAt','updatedAt'])
        && data.schemaVersion == 2 && id(data.operationId) && id(data.exportId) && data.manifestSha256 is string && data.manifestSha256.matches('[a-f0-9]{64}')
        && data.counts is map && data.counts.keys().hasOnly(['items','rooms','boxes','photos','photoFiles'])
        && data.counts.items is int && data.counts.items >= 0 && data.counts.items <= 5000
        && data.counts.rooms is int && data.counts.rooms >= 0 && data.counts.rooms <= 5000
        && data.counts.boxes is int && data.counts.boxes >= 0 && data.counts.boxes <= 5000
        && data.counts.photos is int && data.counts.photos >= 0 && data.counts.photos <= data.counts.items * 2 && data.counts.photoFiles == data.counts.photos * 2
        && data.claimedRecords is int && data.completedRecords is int && data.completedRecords >= 0 && data.completedRecords <= data.claimedRecords && data.claimedRecords <= restoreTotal(data)
        && data.state in ['restoring','interrupted','completed'] && data.createdAt is timestamp && data.updatedAt == request.time
        && (data.state != 'completed' || (data.completedRecords == restoreTotal(data) && data.claimedRecords == restoreTotal(data)));
    }
    function validRestoreClaim(data, recordKey) {
      return data.keys().hasOnly(['schemaVersion','revision','operationId','kind','recordId','recordSha256','state','deletedAt','coverPhotoId','createdAt','updatedAt'])
        && data.schemaVersion == 2 && id(data.operationId) && data.kind in ['item','room','box'] && id(data.recordId) && recordKey == data.kind + '_' + data.recordId
        && data.recordSha256 is string && data.recordSha256.matches('[a-f0-9]{64}') && data.state in ['pending','verified']
        && (data.deletedAt == null || data.deletedAt is timestamp) && (data.coverPhotoId == null || id(data.coverPhotoId))
        && (data.kind == 'item' || (data.deletedAt == null && data.coverPhotoId == null && data.state == 'verified'))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function claimedCollection(kind) { return kind == 'item' ? 'items' : (kind == 'room' ? 'rooms' : 'boxes'); }
    function newRestoreClaim(data, inventoryId, recordKey) {
      let operation = get(restorePath(inventoryId)).data;
      let after = getAfter(restorePath(inventoryId)).data;
      let collection = claimedCollection(data.kind);
      let target = /databases/$(database)/documents/inventories/$(inventoryId)/$(collection)/$(data.recordId);
      return validRestoreClaim(data,recordKey) && operation.state == 'restoring' && data.operationId == operation.operationId
        && data.revision == 1 && data.createdAt == request.time && data.state == (data.kind == 'item' ? 'pending' : 'verified')
        && !exists(target) && getAfter(target).data.revision == 1 && getAfter(target).data.updatedAt == request.time
        && after.claimedRecords == operation.claimedRecords + 1
        && after.completedRecords == operation.completedRecords + (data.kind == 'item' ? 0 : 1);
    }
    function finishedRestoreClaim(data, inventoryId, recordKey) {
      let before = resource.data;
      let operation = get(restorePath(inventoryId)).data;
      let after = getAfter(restorePath(inventoryId)).data;
      let item = getAfter(/databases/$(database)/documents/inventories/$(inventoryId)/items/$(data.recordId)).data;
      return validRestoreClaim(data,recordKey) && before.kind == 'item' && before.state == 'pending' && data.state == 'verified'
        && operation.state == 'restoring' && data.operationId == operation.operationId
        && data.diff(before).affectedKeys().hasOnly(['state','revision','updatedAt']) && data.revision == before.revision + 1
        && item.recordState == 'ready' && readyPhotos(item) && item.deletedAt == data.deletedAt && item.coverPhotoId == data.coverPhotoId
        && after.completedRecords == operation.completedRecords + 1 && after.claimedRecords == operation.claimedRecords;
    }
    match /inventories/{inventoryId} {
      allow get: if owns(inventoryId);
      allow update: if owns(inventoryId) && unlocked(inventoryId) && validSettings();
      allow list, create, delete: if false;

      match /items/{itemId} {
        allow get, list: if owns(inventoryId);
        allow create: if owns(inventoryId) && (unlocked(inventoryId)
          ? newCapture(request.resource.data,inventoryId,itemId) : restoredItem(request.resource.data,inventoryId,itemId));
        allow update: if owns(inventoryId) && resource.data.schemaVersion == 2 && request.resource.data.schemaVersion == 2
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.revision <= 9007199254740991
          && (unlocked(inventoryId) ? (request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos','coverPhotoId','recordState'])
            ? (permanentMarker(request.resource.data) || completion(request.resource.data,inventoryId,itemId) || discard(request.resource.data) || firstPhotos(request.resource.data,inventoryId,itemId))
            : metadataEdit(request.resource.data,inventoryId))
          : (pendingRestoreItem(inventoryId,itemId) && (firstPhotos(request.resource.data,inventoryId,itemId) || restoredItemFinal(request.resource.data,inventoryId,itemId))));
        allow delete: if owns(inventoryId) && unlocked(inventoryId) && resource.data.recordState == 'deleting'
          && ((resource.data.coverPhotoId == null && resource.data.deletedAt == null)
            || (resource.data.deletedAt is timestamp && readyPhotos(resource.data)));
      }
      match /rooms/{roomId} {
        allow get, list: if owns(inventoryId);
        allow create: if owns(inventoryId) && (unlocked(inventoryId) ? newRoom(request.resource.data,roomId) : restoredLocation(request.resource.data,inventoryId,'room',roomId));
        allow update: if owns(inventoryId) && unlocked(inventoryId) && editLocation(request.resource.data,false);
        allow delete: if false;
      }
      match /boxes/{boxId} {
        allow get, list: if owns(inventoryId);
        allow create: if owns(inventoryId) && (unlocked(inventoryId) ? (id(boxId) && validLocationRecord(request.resource.data,true)
          && request.resource.data.revision == 1 && request.resource.data.archivedAt == null
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time)
          : restoredLocation(request.resource.data,inventoryId,'box',boxId));
        allow update: if owns(inventoryId) && unlocked(inventoryId) && editLocation(request.resource.data,true);
        allow delete: if false;
      }
      match /restores/active {
        allow get: if owns(inventoryId);
        allow list: if false;
        allow create: if owns(inventoryId) && validRestore(request.resource.data) && request.resource.data.revision == 1
          && request.resource.data.state == 'restoring' && request.resource.data.claimedRecords == 0 && request.resource.data.completedRecords == 0
          && request.resource.data.createdAt == request.time;
        allow update: if owns(inventoryId) && validRestore(request.resource.data) && resource.data.state != 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision','updatedAt','state','claimedRecords','completedRecords'])
          && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.revision <= 9007199254740991
          && request.resource.data.claimedRecords >= resource.data.claimedRecords && request.resource.data.claimedRecords <= resource.data.claimedRecords + 1
          && request.resource.data.completedRecords >= resource.data.completedRecords && request.resource.data.completedRecords <= resource.data.completedRecords + 1;
        allow delete: if owns(inventoryId) && resource.data.state == 'interrupted' && resource.data.claimedRecords == 0;
        match /records/{recordKey} {
          allow get, list: if owns(inventoryId);
          allow create: if owns(inventoryId) && newRestoreClaim(request.resource.data,inventoryId,recordKey);
          allow update: if owns(inventoryId) && finishedRestoreClaim(request.resource.data,inventoryId,recordKey);
          allow delete: if false;
        }
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
