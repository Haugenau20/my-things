# EMULATOR-ONLY CONFIGURATION. M0 validates every required value before SDK initialization.
# Copy to .env.local. Start all three emulators before running npm run dev.
# All VITE_ values are browser-visible. Never add private/admin credentials.
# VITE_APP_ENV is the application's discriminator, not a required Vite mode name.
VITE_APP_ENV=local
VITE_USE_EMULATORS=true
VITE_INVENTORY_ID=main

# Deliberately fake demo project configuration; never use for a cloud build.
VITE_FIREBASE_API_KEY=demo-not-a-real-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-inventory.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-inventory
VITE_FIREBASE_STORAGE_BUCKET=demo-inventory.firebasestorage.app
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# All three services MUST connect to their emulators before use.
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_PORT=9199

# A seed script may use a synthetic UID in the Auth emulator.
# This file does not grant authorization or make its user an inventory owner.
