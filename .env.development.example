# Copy to .env.development.local. Fill from the actual console; no values are inferred.
# This dedicated file does not inherit .env.local. All VITE_ values are browser-visible.
VITE_APP_ENV=development
VITE_USE_EMULATORS=false
VITE_INVENTORY_ID=main
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Build-only destination checks; these are NOT shipped to the browser.
APP_DEVELOPMENT_PROJECT_ID=
APP_PRODUCTION_PROJECT_ID=
