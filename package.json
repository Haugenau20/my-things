{
  "name": "my-things",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "emulators": "node scripts/emulators.mjs start",
    "seed:local": "node scripts/seed-local.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "node scripts/emulators.mjs rules",
    "test:integration": "node scripts/emulators.mjs integration",
    "test:e2e": "node scripts/emulators.mjs e2e",
    "build": "node scripts/build.mjs local",
    "build:dev": "node scripts/build.mjs development",
    "build:prod": "node scripts/build.mjs production",
    "deploy:check": "node scripts/deploy-check.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:rules && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "firebase-tools": "15.33.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "re2": false,
    "google-logging-utils": false
  }
}
